# Database (PostgreSQL default, falls back to SQLite for instant local dev if PostgreSQL is not running)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptive_db

# Security & Authentication
JWT_SECRET=adaptive-learning-secret-key-hackathon-2026-production-grade
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI Provider (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Service URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
SANDBOX_MODE=auto
