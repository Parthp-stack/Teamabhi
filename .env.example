# Database:
# For Local Dev: SQLite fallback is automatic or you can specify:
# DATABASE_URL=sqlite:///./adaptive_learning.db
#
# For Supabase / Render:
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptive_db

# Supabase API Settings (Found in Supabase -> Project Settings -> API)
# Project URL:
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
# Public Anon Key (Safe for client/frontend if needed):
SUPABASE_ANON_KEY=eyJhbGciOi...
# Secret Service Role Key (Private backend admin key - NEVER expose to frontend):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Security & Authentication
JWT_SECRET=adaptive-learning-secret-key-hackathon-2026-production-grade
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# AI Provider (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Email & OTP Service (Resend / SMTP)
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
# Optional SMTP fallback:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Service URLs
# When deployed on Render:
# FRONTEND_URL=https://your-frontend.onrender.com
# BACKEND_URL=https://your-backend.onrender.com
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
SANDBOX_MODE=auto
